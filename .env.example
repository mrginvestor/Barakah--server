PORT=5000
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=info@halalwealth.finance
# Use either a bcrypt hash or a server-side plain text password for a single admin account.
# Generate a hash with: node src/scripts/generateAdminPasswordHash.js
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
# Use both local Vite ports in development. In production, set FRONTEND_URLS
# to the deployed frontend origin(s), for example https://www.halalwealth.finance.
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# ==============================================================================
# Email Configuration (Hostinger SMTP via Nodemailer)
# ==============================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com

# --- Port Selection & TLS Modes ---
# Option 1 (Recommended / Default): Port 465 with implicit TLS / SMTPS
SMTP_PORT=465
SMTP_SECURE=true

# Option 2 (Alternative): Port 587 with STARTTLS (explicit TLS)
# SMTP_PORT=587
# SMTP_SECURE=false

# Hostinger Mailbox Credentials
SMTP_USER=info@halalwealth.finance
SMTP_PASS=REPLACE_WITH_HOSTINGER_SMTP_PASSWORD

# Sender Address & Display Name
EMAIL_FROM=info@halalwealth.finance
EMAIL_FROM_NAME=Halal Wealth Webinar
# EMAIL_REPLY_TO=info@halalwealth.finance
# MAIL_FROM=info@halalwealth.finance
# MAIL_FROM_NAME=Halal Wealth Webinar

# ------------------------------------------------------------------------------
# CLOUD HOSTING & RENDER OUTBOUND SMTP RESTRICTION NOTICE:
# ------------------------------------------------------------------------------
# Render Free Web Services block outbound TCP network traffic on SMTP ports 25,
# 465, and 587 to prevent platform spam/abuse. If deployed on Render Free tier,
# connecting to smtp.hostinger.com:465 (or :587) will fail with ETIMEDOUT (Connection timeout).
#
# To use Hostinger SMTP in production on Render:
# 1. Upgrade the Render Web Service to a Paid Instance (e.g. Starter tier $7/mo).
#    Paid instances automatically unblock outbound traffic on ports 465 and 587
#    (port 25 remains globally blocked).
# 2. Alternatively, host the backend on an infrastructure allowing outbound SMTP
#    egress (e.g. VPS, DigitalOcean Droplet, Railway, Hostinger Cloud, AWS EC2).
# 3. If remaining on Render Free tier, an HTTP API-based email provider (over HTTPS port 443)
#    would be required since Render does not restrict port 443.

# Set to true to close public registration for the webinar, or false to keep registration open
WEBINAR_REGISTRATION_CLOSED=false
